\": [\n                    \"Modules/testExtension/Templates/jj_testextension_testextension.tpl\",\n                    \"Modules/testExtension/Templates/testExtension_delivery.tpl\",\n                    \"Modules/testExtension/Templates/jj_product_details_full.tpl\"\n                ]\n            }\n        }\n    },\n    \"sass\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/testExtension/Sass/_testextension-testextension.scss\",\n            \"myaccount\": \"Modules/testExtension/Sass/_testextension-testextension.scss\",\n            \"checkout\": \"Modules/testExtension/Sass/_testextension-testextension.scss\"\n        },\n        \"files\": [\n            \"Modules/testExtension/Sass/_testextension-testextension.scss\"\n        ]\n    },\n    \"javascript\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.js\",\n            \"myaccount\": \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.js\",\n            \"checkout\": \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.js\"\n        },\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.js\",\n                    \"Modules/testExtension/JavaScript/testExtension.View.js\",\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.Model.js\",\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.SS2Model.js\",\n                    \"Modules/testExtension/JavaScript/productDetailsFull.View.js\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.js\",\n                    \"Modules/testExtension/JavaScript/testExtension.View.js\",\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.Model.js\",\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.SS2Model.js\",\n                    \"Modules/testExtension/JavaScript/productDetailsFull.View.js\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.js\",\n                    \"Modules/testExtension/JavaScript/testExtension.View.js\",\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.Model.js\",\n                    \"Modules/testExtension/JavaScript/JJ.testExtension.testExtension.SS2Model.js\",\n                    \"Modules/testExtension/JavaScript/productDetailsFull.View.js\"\n                ]\n            }\n        }\n    },\n    \"ssp-libraries\": {\n        \"entry_point\": \"Modules/testExtension/SuiteScript/JJ.testExtension.testExtension.js\",\n        \"files\": [\n            \"Modules/testExtension/SuiteScript/JJ.testExtension.testExtension.js\",\n            \"Modules/testExtension/SuiteScript/testExtension.ServiceController.js\"\n        ]\n    },\n    \"suitescript2\": {\n        \"files\": [\n            \"Modules/testExtension/SuiteScript2/testExtension.Service.ss\"\n        ]\n    }\n}"},{"path":"\\JJ\\testExtension@1.0.0\\Modules\\testExtension\\JavaScript\\productDetailsFull.View.js","type":"application/javascript","contents":"define('JJ.testExtension.productDetailsFull.View', [\n    'ProductDetails.Full.View',\n    'jj_product_details_full.tpl',\n    'underscore',\n    'jQuery'\n], function (\n    ProductDetailsFullView,\n    product_details_full_tpl,\n    _,\n    $\n) {\n    'use strict';\n\n    return {\n        loadExtension: function () {\n\n            ProductDetailsFullView.prototype.template = product_details_full_tpl;\n\n            ProductDetailsFullView.prototype.events = _.extend({}, ProductDetailsFullView.prototype.events, {\n                'click [data-action=\"show-warranty-info\"]': 'showWarrantyInfo',\n                'change [data-action=\"update-delivery-note\"]': 'validateDeliveryNote',\n                'blur [data-action=\"update-delivery-note\"]': 'blurDeliveryNote'\n            });\n\n\n            _.extend(ProductDetailsFullView.prototype, {\n                showWarrantyInfo: function (e) {\n                    e.preventDefault();\n                    alert('Warranty Info: This item includes a 1-year manufacturer warranty.');\n                },\n\n                validateDeliveryNote: function (e) {\n                    var val = $(e.currentTarget).val();\n                    if (val && val.length < 5) {\n                        alert('Please enter a more detailed delivery note (at least 5 characters).');\n                    }\n                },\n\n                blurDeliveryNote: function (e) {\n                    console.log('Delivery note input blurred.', $(e.currentTarget).val());\n                }\n            });\n\n\n            ProductDetailsFullView.prototype.getContext = _.wrap(ProductDetailsFullView.prototype.getContext, function (originalGetContext) {\n\n                var context = originalGetContext.apply(this, _.toArray(arguments).slice(1));\n\n                var item = this.model.get('item');\n\n                context.custitem_expected_delivery = (item && item.get('custitem_expected_delivery')) || '3-5 Business Days';\n                context.custcol_special_note = 'No special notes available.';\n\n                context.showWarrantyInfo = true;\n                context.showDeliverySection = true;\n\n                return context;\n            });\n        }\n    };\n});\n"},{"path":"\\JJ\\testExtension@1.0.0\\Modules\\testExtension\\Sass\\_testextension-testextension.scss","type":"text/x-scss","contents":"\n\n\n.testextension-info-card {\n  @extend .info-card;\n\n  &__content {\n    @extend .info-card-content;\n    color: $sc-color-secondary;\n    font-weight: bold;\n  }\n\n \n .close {\n    cursor: pointer;\n    padding: 4px 8px;\n    border-radius: 50%;          // fully rounded (circle)\n    background-color: $sc-color-secondary;\n    color: #fff;\n    border: none;\n    font-size: 12px;\n    line-height: 1;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    &:hover {\n      background-color: darken($sc-color-secondary, 10%);\n    }\n\n    &:active {\n      transform: scale(0.95);\n    }\n  }\n\n\n\n\n}\n\n/* CUSTOM DELIVERY SECTION BEM STYLES */\n.testextension-delivery {\n  margin-top: 15px;\n  padding: 15px;\n  border: 1px solid $sc-color-theme-border;\n  border-radius: $sc-border-radius;\n  background-color: $sc-color-theme-background;\n\n  &__title {\n    margin-bottom: 10px;\n    font-weight: 600;\n  }\n\n  &__info {\n    margin-bottom: 5px;\n\n    strong {\n      color: $sc-color-primary;\n    }\n  }\n\n  &__note {\n    margin-bottom: 10px;\n    color: $sc-color-secondary;\n  }\n\n  &__form-group {\n    margin-top: 10px;\n  }\n\n  &__label {\n    display: block;\n    margin-bottom: 5px;\n    font-size: 13px;\n    color: $sc-color-copy;\n  }\n\n  &__input {\n    width: 100%;\n    padding: 8px;\n    border: 1px solid $sc-color-theme-border;\n    border-radius: $sc-border-radius;\n    box-sizing: border-box;\n\n    &:focus {\n      outline: none;\n      border-color: $sc-color-primary;\n    }\n  }\n\n  &__button {\n    margin-top: 15px;\n    padding: 10px 15px;\n    background-color: $sc-color-primary;\n    color: #fff;\n    border: none;\n    border-radius: $sc-border-radius;\n    cursor: pointer;\n    font-weight: 600;\n    transition: background-color 0.2s ease;\n\n    &:hover {\n      background-color: darken($sc-color-primary, 10%);\n    }\n\n    &:active {\n      transform: scale(0.98);\n    }\n  }\n}\n"},{"path":"\\JJ\\testExtension@1.0.0\\Modules\\testExtension\\Templates\\jj_product_details_full.tpl","type":"application/vnd.groove-tool-template","contents":"{{!-- Edited for Horizon Theme - Extension Override --}}\n\n<div class=\"product-details-full\">\n\t<div data-cms-area=\"item_details_banner\" data-cms-area-filters=\"page_type\"></div>\n\n\t<header class=\"product-details-full-header\">\n\t\t<div id=\"banner-content-top\" class=\"product-details-full-banner-top\"></div>\n\t</header>\n\n\t<article class=\"product-details-full-content\">\n\n\t\t<div id=\"banner-details-top\" class=\"product-details-full-banner-top-details\"></div>\n\n\t\t<section class=\"product-details-full-main-content\">\n\t\t\t<div class=\"product-details-full-content-header\">\n\t\t\t\t<div data-cms-area=\"product_details_full_cms_area_1\" data-cms-area-filters=\"page_type\"></div>\n\t\t\t\t<h1 class=\"product-details-full-content-header-title\" itemprop=\"name\">{{pageHeader}}</h1>\n\t\t\t\t<div class=\"product-details-full-rating\" data-view=\"Global.StarRating\"></div>\n\t\t\t\t<div data-view=\"ItemDetails.Header\"></div>\n\t\t\t\t<div data-cms-area=\"item_info\" data-cms-area-filters=\"path\"></div>\n\t\t\t</div>\n\t\t\t<div class=\"product-details-full-main-content-left\">\n\t\t\t\t<div class=\"product-details-full-image-gallery-container\">\n\t\t\t\t\t<div id=\"banner-image-top\" class=\"content-banner banner-image-top\"></div>\n\t\t\t\t\t<div data-view=\"Product.ImageGallery\"></div>\n\t\t\t\t\t<div id=\"banner-image-bottom\" class=\"content-banner banner-image-bottom\"></div>\n\t\t\t\t\t<div data-cms-area=\"product_details_full_cms_area_2\" data-cms-area-filters=\"path\"></div>\n\t\t\t\t\t<div data-cms-area=\"product_details_full_cms_area_3\" data-cms-area-filters=\"page_type\"></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"product-details-full-main-content-right\">\n\t\t\t<div class=\"product-details-full-divider\"></div>\n\n\t\t\t<div class=\"product-details-full-main\">\n\t\t\t\t{{#if isItemProperlyConfigured}}\n\t\t\t\t\t<form id=\"product-details-full-form\" data-action=\"submit-form\" method=\"POST\">\n\n\t\t\t\t\t\t<section class=\"product-details-full-info\">\n\t\t\t\t\t\t\t<div id=\"banner-summary-bottom\" class=\"product-details-full-banner-summary-bottom\"></div>\n\t\t\t\t\t\t</section>\n\n\t\t\t\t\t\t<div data-view=\"Product.Price\"></div>\n\t\t\t\t\t\t<div data-view=\"Quantity.Pricing\"></div>\n\t\t\t\t\t\n\n\t\t\t\t\t\t<div data-cms-area=\"product_details_full_cms_area_4\" data-cms-area-filters=\"path\"></div>\n\n\t\t\t\t\t\t<div data-view=\"Product.Sku\"></div>\n\n\t\t\t\t\t\t<section data-view=\"Product.Options\"></section>\n\t\t\t\t\t\t<div data-view=\"Product.Stock.Info\"></div>\n\n\t\t\t\t\t\t{{#if isPriceEnabled}}\n\t\t\t\t\t\t\t<div data-view=\"Quantity\"></div>\n\n\t\t\t\t\t\t\t<section class=\"product-details-full-actions\">\n\n\t\t\t\t\t\t\t\t<div class=\"product-details-full-actions-container\">\n\t\t\t\t\t\t\t\t\t<div data-view=\"MainActionView\"></div>\n\t\t\t\t\t\t\t\t\t<div  data-view=\"ItemActions\"></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"product-details-full-actions-container\">\n\t\t\t\t\t\t\t\t\t<div data-view=\"ProductDetails.AddToQuote\" class=\"product-details-full-actions-addtoquote\"></div>\n                                    <div data-view=\"AddToProductList\" class=\"product-details-full-actions-addtowishlist\"></div>\n\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t</section>\n\t\t\t\t\t\t{{/if}}\n\n<!-- START OF CUSTOM DELIVERY SECTION (FROM EXTENSION) -->\n{{#if showDeliverySection}}\n  <section class=\"testextension-delivery\">\n      <h4 class=\"testextension-delivery__title\">Custom Delivery Details</h4>\n      \n      <!-- Custom Fields Displayed from getContext -->\n      <p class=\"testextension-delivery__info\">Expected Delivery: <strong>{{custitem_expected_delivery}}</strong></p>\n      <p class=\"testextension-delivery__note\">Special Note: <em>{{custcol_special_note}}</em></p>\n      \n      <!-- Input triggering \"change\" and \"blur\" events -->\n      <div class=\"testextension-delivery__form-group\">\n        <label class=\"testextension-delivery__label\">Delivery Note Instructions:</label>\n        <input type=\"text\" class=\"testextension-delivery__input\" data-action=\"update-delivery-note\" placeholder=\"Enter note (min 5 characters)\"/>\n      </div>\n      \n      <!-- Button triggering \"click\" event -->\n      {{#if showWarrantyInfo}}\n         <button class=\"testextension-delivery__button\" data-action=\"show-warranty-info\">\n            View Warranty Info\n         </button>\n      {{/if}}\n  </section>\n{{/if}}\n<!-- END OF CUSTOM DELIVERY SECTION -->\n\n\t\t\t\t\t\t<div data-view=\"StockDescription\"></div>\n\n\t\t\t\t\t\t<div data-view=\"SocialSharing.Flyout\" class=\"product-details-full-social-sharing\"></div>\n\n\t\t\t\t\t\t<div class=\"product-details-full-main-bottom-banner\">\n\t\t\t\t\t\t\t<div id=\"banner-summary-bottom\" class=\"product-details-full-banner-summary-bottom\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</form>\n\t\t\t\t{{else}}\n\t\t\t\t\t<div data-view=\"GlobalViewsMessageView.WronglyConfigureItem\"></div>\n\t\t\t\t{{/if}}\n\n\t\t\t\t<div id=\"banner-details-bottom\" class=\"product-details-full-banner-details-bottom\" data-cms-area=\"item_info_bottom\" data-cms-area-filters=\"page_type\"></div>\n\t\t\t</div>\n\t\t\t</div>\n\n\t\t</section>\n\n\t\t<div data-cms-area=\"product_details_full_cms_area_5\" data-cms-area-filters=\"page_type\"></div>\n\t\t<div data-cms-area=\"product_details_full_cms_area_6\" data-cms-area-filters=\"path\"></div>\n\n\t\t<section data-view=\"Product.Information\">\n\t\t</section>\n\n\t\t<div data-cms-area=\"product_details_full_cms_area_7\" data-cms-area-filters=\"path\"></div>\n\n\t\t<div data-view=\"ProductReviews.Center\"></div>\n\n\t\t<div data-cms-area=\"product_details_full_cms_area_8\" data-cms-area-filters=\"path\"></div>\n\n\t\t<div class=\"product-details-full-content-related-items\">\n\t\t\t<div data-view=\"Related.Items\"></div>\n\t\t</div>\n\n\t\t<div class=\"product-details-full-content-correlated-items\">\n\t\t\t<div data-view=\"Correlated.Items\"></div>\n\t\t</div>\n\t\t<div id=\"banner-details-bottom\" class=\"content-banner banner-details-bottom\" data-cms-area=\"item_details_banner_bottom\" data-cms-area-filters=\"page_type\"></div>\n\t</article>\n</div>\n"}]}