\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\manifest.json\":\"\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\Configuration\\\\SalesPerson.json\":\"dcea9b340ae3f9e61b55c66558c9cf80\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\JavaScript\\\\JJ.SalesPerson.SalesPerson.js\":\"c91bf6679a6c81d7f2da2fae3d9c7d9c\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\JavaScript\\\\JJ.SalesPerson.SalesPerson.SS2Model.js\":\"88c69fde123a19db6c81dc91f1916cf4\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\JavaScript\\\\SalesPerson.View.js\":\"3995299563d8f9e8259164cbce4ce335\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\Sass\\\\_salesperson-salesperson.scss\":\"9d49001a17fe18cfa03ffc2307334d09\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\SuiteScript2\\\\SalesPerson.Service.ss\":\"cb013da0998dfca3c3db9efd5cec9ede\",\"DeployDistribution\\\\JJ\\\\SalesPerson@1.0.0\\\\Modules\\\\SalesPerson\\\\Templates\\\\jj_salesperson_salesperson.tpl\":\"17c7dd4cadcfbda602b4a244e37b3528\"}"},{"path":"\\JJ\\SalesPerson@1.0.0\\manifest.json","type":"application/json","contents":"{\n    \"name\": \"SalesPerson\",\n    \"fantasyName\": \"salePerson\",\n    \"vendor\": \"JJ\",\n    \"type\": \"extension\",\n    \"target\": \"SCA,SCS\",\n    \"target_version\": {\n        \"SCA\": \"\",\n        \"SCS\": \"\"\n    },\n    \"version\": \"1.0.0\",\n    \"description\": \"My cool extension does magic!\",\n    \"templates\": {\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/SalesPerson/Templates/jj_salesperson_salesperson.tpl\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/SalesPerson/Templates/jj_salesperson_salesperson.tpl\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/SalesPerson/Templates/jj_salesperson_salesperson.tpl\"\n                ]\n            }\n        }\n    },\n    \"sass\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/SalesPerson/Sass/_salesperson-salesperson.scss\",\n            \"myaccount\": \"Modules/SalesPerson/Sass/_salesperson-salesperson.scss\",\n            \"checkout\": \"Modules/SalesPerson/Sass/_salesperson-salesperson.scss\"\n        },\n        \"files\": [\n            \"Modules/SalesPerson/Sass/_salesperson-salesperson.scss\"\n        ]\n    },\n    \"javascript\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.js\",\n            \"myaccount\": \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.js\",\n            \"checkout\": \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.js\"\n        },\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.js\",\n                    \"Modules/SalesPerson/JavaScript/SalesPerson.View.js\",\n                    \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.SS2Model.js\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.js\",\n                    \"Modules/SalesPerson/JavaScript/SalesPerson.View.js\",\n                    \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.SS2Model.js\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.js\",\n                    \"Modules/SalesPerson/JavaScript/SalesPerson.View.js\",\n                    \"Modules/SalesPerson/JavaScript/JJ.SalesPerson.SalesPerson.SS2Model.js\"\n                ]\n            }\n        }\n    },\n    \"suitescript2\": {\n        \"files\": [\n            \"Modules/SalesPerson/SuiteScript2/SalesPerson.Service.ss\"\n        ]\n    }\n}"},{"path":"\\JJ\\SalesPerson@1.0.0\\Modules\\SalesPerson\\JavaScript\\JJ.SalesPerson.SalesPerson.js","type":"application/javascript","contents":"define(\r\n\t'JJ.SalesPerson.SalesPerson'\r\n,   [\r\n\t\t'JJ.SalesPerson.SalesPerson.View'\r\n\t]\r\n,   function (\r\n\t\tSalesPersonView\r\n\t)\r\n{\r\n\t'use strict';\r\n\r\n\treturn  {\r\n\t\tmountToApp: function mountToApp (container)\r\n\t\t{\r\n\t\t\tconsole.log('SalesPerson Extension Loading...');\r\n\t\t\t\r\n\t\t\t// Using Layout component as it is available across all application contexts\r\n\t\t\tvar layout = container.getComponent('Layout');\r\n\t\t\t\r\n\t\t\tif (layout)\r\n\t\t\t{\r\n\t\t\t\tconsole.log('Layout Component found. Mounting views...');\r\n\r\n\t\t\t\t// Mount to Account Overview Banner\r\n\t\t\t\tlayout.addChildView('Overview.Banner', function() { \r\n\t\t\t\t\treturn new SalesPersonView({ container: container });\r\n\t\t\t\t});\r\n\r\n\t\t\t\t// Mount to Recent Purchases (Order History) page Banner\r\n\t\t\t\tlayout.addChildView('OrderHistory.List.Banner', function() { \r\n\t\t\t\t\treturn new SalesPersonView({ container: container });\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t\telse {\r\n\t\t\t\tconsole.error('SalesPerson Error: Layout component not found.');\r\n\t\t\t}\r\n\t\t}\r\n\t};\r\n});\r\n\r\n\r\n"},{"path":"\\JJ\\SalesPerson@1.0.0\\Modules\\SalesPerson\\JavaScript\\JJ.SalesPerson.SalesPerson.SS2Model.js","type":"application/javascript","contents":"// Model.js\r\n// -----------------------\r\n// @module Case\r\ndefine(\"JJ.SalesPerson.SalesPerson.SS2Model\", [\"Backbone\", \"Utils\"], function(\r\n    Backbone,\r\n    Utils\r\n) {\r\n    \"use strict\";\r\n\r\n    // @class Case.Fields.Model @extends Backbone.Model\r\n    return Backbone.Model.extend({\r\n        //@property {String} urlRoot\r\n        urlRoot: Utils.getAbsoluteUrl(\r\n            getExtensionAssetsPath(\r\n                \"Modules/SalesPerson/SuiteScript2/SalesPerson.Service.ss\"\r\n            ),\r\n            true\r\n        )\r\n    });\r\n});"},{"path":"\\JJ\\SalesPerson@1.0.0\\Modules\\SalesPerson\\JavaScript\\SalesPerson.View.js","type":"application/javascript","contents":"// @module JJ.SalesPerson.SalesPerson\r\ndefine('JJ.SalesPerson.SalesPerson.View'\r\n\t, [\r\n\t\t'jj_salesperson_salesperson.tpl'\r\n\t\t, 'JJ.SalesPerson.SalesPerson.SS2Model'\r\n\t\t, 'Backbone'\r\n\t]\r\n\t, function (\r\n\t\tjj_salesperson_salesperson_tpl\r\n\t\t, SalesPersonSS2Model\r\n\t\t, Backbone\r\n\t) {\r\n\t\t'use strict';\r\n\r\n\t\treturn Backbone.View.extend({\r\n\r\n\t\t\ttemplate: jj_salesperson_salesperson_tpl\r\n\r\n\t\t\t, initialize: function (options) {\r\n\t\t\t\tthis.model = new SalesPersonSS2Model();\r\n\t\t\t\tvar self = this;\r\n\t\t\t\tthis.isLoading = true;\r\n\r\n\t\t\t\tthis.model.fetch().done(function () {\r\n\t\t\t\t\tself.isLoading = false;\r\n\t\t\t\t\tself.render();\r\n\t\t\t\t}).fail(function (e) {\r\n\t\t\t\t\tself.isLoading = false;\r\n\t\t\t\t\tconsole.error(\"SalesPerson fetch failed\", e);\r\n\t\t\t\t\tself.render();\r\n\t\t\t\t});\r\n\t\t\t}\r\n\r\n\t\t\t, getContext: function getContext() {\r\n\t\t\t\treturn {\r\n\t\t\t\t\tisLoading: this.isLoading,\r\n\t\t\t\t\tshowRepresentative: this.model.get('assigned') && !this.isLoading,\r\n\t\t\t\t\t\r\n\t\t\t\t\tname: this.model.get('name'),\r\n\t\t\t\t\ttitle: this.model.get('title'),\r\n\t\t\t\t\tcomments: this.model.get('comments'),\r\n\t\t\t\t\temail: this.model.get('email'),\r\n\t\t\t\t\tphone: this.model.get('phone'),\r\n\t\t\t\t\timage: this.model.get('image'),\r\n\t\t\t\t\tmeetingLink: this.model.get('meeting_link')\r\n\t\t\t\t};\r\n\t\t\t}\r\n\t\t});\r\n\t});\r\n"},{"path":"\\JJ\\SalesPerson@1.0.0\\Modules\\SalesPerson\\Sass\\_salesperson-salesperson.scss","type":"text/x-scss","contents":".salesperson-card {\n    background: #fff;\n    border-radius: 10px;\n    box-shadow: 0 5px 15px rgba(0,0,0,0.05);\n    padding: 20px;\n    margin: 15px 0;\n    border: 1px solid #f0f0f0;\n    max-width: 800px;\n    transition: all 0.3s ease-in-out; // Animation transition\n\n    &:hover {\n        transform: translateY(-5px); // Lift effect\n        box-shadow: 0 12px 25px rgba(0,0,0,0.1); // Deeper shadow\n    }\n\n    .salesperson-card-container {\n        display: flex;\n        align-items: center;\n        gap: 25px;\n\n        @media (max-width: 768px) {\n            flex-direction: column;\n            text-align: center;\n        }\n    }\n\n    .salesperson-image-column {\n        flex-shrink: 0;\n        transition: transform 0.3s ease;\n\n        .salesperson-image-round {\n            width: 100px;\n            height: 100px;\n            border-radius: 50%;\n            object-fit: cover;\n            border: 2px solid #eee;\n        }\n\n        .salesperson-image-placeholder-round {\n            width: 100px;\n            height: 100px;\n            border-radius: 50%;\n            background: #f5f5f5;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 36px;\n            color: #ccc;\n            font-weight: 600;\n        }\n    }\n\n    .salesperson-info-column {\n        flex-grow: 1;\n\n        .salesperson-card-name {\n            margin: 0 0 2px 0;\n            font-size: 20px;\n            font-weight: 700;\n            color: #222;\n        }\n\n        .salesperson-card-title {\n            margin: 0 0 10px 0;\n            font-size: 14px;\n            color: #999;\n        }\n\n        .salesperson-card-bio {\n            margin: 0 0 15px 0;\n            font-size: 13px;\n            line-height: 1.5;\n            color: #666;\n        }\n\n        .salesperson-card-contact-list {\n            margin-bottom: 15px;\n\n            p {\n                margin: 0 0 5px 0;\n                font-size: 13px;\n                color: #333;\n                display: flex; // Ensure labels and values line up\n                align-items: center;\n\n                strong {\n                    display: inline-block;\n                    width: 85px; // Fixed alignment: enough for \"LinkedIn:\"\n                    color: #444;\n                    flex-shrink: 0;\n                }\n\n                a {\n                    color: #007bff;\n                    text-decoration: none;\n                    &:hover { text-decoration: underline; }\n                }\n            }\n        }\n\n        .salesperson-card-button-wrapper {\n            margin-top: 5px;\n        }\n\n        .salesperson-card-green-button {\n            display: inline-block;\n            background-color: #4bc53e;\n            color: #fff;\n            padding: 8px 25px;\n            border-radius: 20px;\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 14px;\n            transition: all 0.3s ease;\n\n            &:hover {\n                background-color: darken(#4bc53e, 8%);\n                color: #fff;\n                transform: scale(1.05); // Button scale effect\n            }\n        }\n    }\n}\n\n.salesperson-unavailable {\n    background: #fff;\n    border: 1px solid #eee;\n    border-radius: 10px;\n    padding: 20px;\n    margin: 15px 0;\n    text-align: center;\n    max-width: 800px;\n    transition: transform 0.3s ease;\n\n    &:hover {\n        transform: scale(1.01);\n    }\n\n    p {\n        margin: 0;\n        color: #888;\n        font-size: 13px;\n        \n        &::before {\n            content: \"ℹ\"; \n            margin-right: 8px;\n            color: #4bc53e;\n        }\n    }\n}"},{"path":"\\JJ\\SalesPerson@1.0.0\\Modules\\SalesPerson\\SuiteScript2\\SalesPerson.Service.ss","type":null,"contents":"/**\r\n * @NApiVersion 2.x\r\n * @NModuleScope Public\r\n */\r\ndefine(['N/runtime', 'N/search', 'N/file', 'N/record', 'N/log', 'N/https', 'N/url'], function (runtime, search, file, record, log, https, url) {\r\n    \"use strict\";\r\n    return {\r\n        service: function (ctx) {\r\n            var user = runtime.getCurrentUser();\r\n            var response = {\r\n                assigned: false,\r\n                name: '',\r\n                title: '',\r\n                email: '',\r\n                comments: '',\r\n                phone: '',\r\n                image: '',\r\n                meeting_link: ''\r\n            };\r\n\r\n            ctx.response.addHeader({\r\n                name: 'Content-Type',\r\n                value: 'application/json'\r\n            });\r\n\r\n            if (user.id > 0) {\r\n                try {\r\n                    var salesRepId = null;\r\n\r\n                    try {\r\n                        var customerRecord = record.load({\r\n                            type: record.Type.CUSTOMER,\r\n                            id: user.id\r\n                        });\r\n                        salesRepId = customerRecord.getValue({ fieldId: 'salesrep' });\r\n                    } catch (loadError) {\r\n                        var customerData = search.lookupFields({\r\n                            type: search.Type.CUSTOMER,\r\n                            id: user.id,\r\n                            columns: ['salesrep']\r\n                        });\r\n                        if (customerData.salesrep && customerData.salesrep.length > 0) {\r\n                            salesRepId = customerData.salesrep[0].value;\r\n                        }\r\n                    }\r\n\r\n                    if (salesRepId) {\r\n                        var suiteletUrl = 'https://td3079995.extforms.netsuite.com/app/site/hosting/scriptlet.nl?script=2264&deploy=1&compid=TD3079995&ns-at=AAEJ7tMQQGE0HwkDDB_eV3iWooLGL0syHGfgJXZP6R-cQkYhnus';\r\n                        \r\n                        var suiteletResponse = https.get({\r\n                            url: suiteletUrl + '&repId=' + salesRepId\r\n                        });\r\n                      \r\n                        var employeeData = JSON.parse(suiteletResponse.body);\r\n                        \r\n                        if (employeeData.assigned || employeeData.success) {\r\n                            response.assigned = true;\r\n                            response.name = employeeData.name || '';\r\n                            \r\n                            // Safe Title Handling\r\n                            if (employeeData.title && employeeData.title.length > 0 && typeof employeeData.title !== 'string') {\r\n                                response.title = employeeData.title[0].text;\r\n                            } else {\r\n                                response.title = employeeData.title || '';\r\n                            }\r\n\r\n                            response.email = employeeData.email || '';\r\n                            response.comments = employeeData.comments || '';\r\n                            response.phone = employeeData.phone || '';\r\n                            response.meeting_link = employeeData.meeting_link || '';\r\n                            response.image = employeeData.image || '';\r\n                        }\r\n                    }\r\n                } catch (e) {\r\n                    log.error(\"Final Service Error\", e);\r\n                    response.error = e.message;\r\n                }\r\n            }\r\n\r\n            ctx.response.write(JSON.stringify(response));\r\n        }\r\n    };\r\n});\r\n"},{"path":"\\JJ\\SalesPerson@1.0.0\\Modules\\SalesPerson\\Templates\\jj_salesperson_salesperson.tpl","type":"application/vnd.groove-tool-template","contents":"{{#if showRepresentative}}\r\n<div class=\"salesperson-card\">\r\n    <div class=\"salesperson-card-container\">\r\n        \r\n        {{!-- Left side: Large circular image --}}\r\n        <div class=\"salesperson-image-column\">\r\n            {{#if image}}\r\n                <img src=\"{{image}}\" alt=\"{{name}}\" class=\"salesperson-image-round\">\r\n            {{else}}\r\n                <div class=\"salesperson-image-placeholder-round\">\r\n                    <span>{{name.[0]}}</span>\r\n                </div>\r\n            {{/if}}\r\n        </div>\r\n\r\n        {{!-- Right side: Information and Action --}}\r\n        <div class=\"salesperson-info-column\">\r\n            <h2 class=\"salesperson-card-name\">{{name}}</h2>\r\n            <p class=\"salesperson-card-title\">{{title}}</p>\r\n            \r\n            {{#if comments}}\r\n                <p class=\"salesperson-card-bio\">{{comments}}</p>\r\n            {{/if}}\r\n\r\n            <div class=\"salesperson-card-contact-list\">\r\n                <p><strong>Email:</strong> <a href=\"mailto:{{email}}\">{{email}}</a></p>\r\n                <p><strong>Phone:</strong> <a href=\"tel:{{phone}}\">{{phone}}</a></p>\r\n                {{#if meetingLink}}\r\n                    <p><strong>LinkedIn:</strong> <a href=\"{{meetingLink}}\" target=\"_blank\">Connect with {{name}}</a></p>\r\n                {{/if}}\r\n            </div>\r\n\r\n            {{#if meetingLink}}\r\n                <div class=\"salesperson-card-button-wrapper\">\r\n                    <a href=\"{{meetingLink}}\" class=\"salesperson-card-green-button\" target=\"_blank\">\r\n                        Schedule a Meeting\r\n                    </a>\r\n                </div>\r\n            {{/if}}\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n{{else}}\r\n    {{#unless isLoading}}\r\n        <div class=\"salesperson-unavailable\">\r\n            <p>{{translate 'Your representative information is currently unavailable.'}}</p>\r\n        </div>\r\n    {{/unless}}\r\n{{/if}}"}]}