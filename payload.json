     \"Modules/MyFooter/Configuration/MyFooter.json\"\n        ]\n    },\n    \"templates\": {\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/MyFooter/Templates/jj_footer_myfooter.tpl\",\n                    \"Modules/MyFooter/Templates/jj_footer_empty.tpl\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/MyFooter/Templates/jj_footer_myfooter.tpl\",\n                    \"Modules/MyFooter/Templates/jj_footer_empty.tpl\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/MyFooter/Templates/jj_footer_myfooter.tpl\",\n                    \"Modules/MyFooter/Templates/jj_footer_empty.tpl\"\n                ]\n            }\n        }\n    },\n    \"sass\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/MyFooter/Sass/_footer-myfooter.scss\",\n            \"myaccount\": \"Modules/MyFooter/Sass/_footer-myfooter.scss\",\n            \"checkout\": \"Modules/MyFooter/Sass/_footer-myfooter.scss\"\n        },\n        \"files\": [\n            \"Modules/MyFooter/Sass/_footer-myfooter.scss\"\n        ]\n    },\n    \"javascript\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.js\",\n            \"myaccount\": \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.js\",\n            \"checkout\": \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.js\"\n        },\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.js\",\n                    \"Modules/MyFooter/JavaScript/MyFooter.View.js\",\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.Model.js\",\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.SS2Model.js\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.js\",\n                    \"Modules/MyFooter/JavaScript/MyFooter.View.js\",\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.Model.js\",\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.SS2Model.js\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.js\",\n                    \"Modules/MyFooter/JavaScript/MyFooter.View.js\",\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.Model.js\",\n                    \"Modules/MyFooter/JavaScript/JJ.Footer.MyFooter.SS2Model.js\"\n                ]\n            }\n        }\n    },\n    \"ssp-libraries\": {\n        \"entry_point\": \"Modules/MyFooter/SuiteScript/JJ.Footer.MyFooter.js\",\n        \"files\": [\n            \"Modules/MyFooter/SuiteScript/JJ.Footer.MyFooter.js\",\n            \"Modules/MyFooter/SuiteScript/MyFooter.ServiceController.js\"\n        ]\n    },\n    \"suitescript2\": {\n        \"files\": [\n            \"Modules/MyFooter/SuiteScript2/MyFooter.Service.ss\"\n        ]\n    }\n}"},{"path":"\\JJ\\Footer@1.0.0\\Modules\\MyFooter\\Sass\\_footer-myfooter.scss","type":"text/x-scss","contents":".myfooter-wrapper {\n    background-color: #000;\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    padding: 0;\n}\n\n/* Newsletter Bar (Top) */\n.myfooter-newsletter-bar {\n    background-color: #000;\n    padding: 40px 0;\n    border-bottom: 1px solid #1a1a1a;\n}\n\n.myfooter-newsletter-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 40px;\n    padding: 0 20px;\n}\n\n.myfooter-newsletter-bar-text {\n    font-size: 16px;\n    color: #fff;\n    font-weight: 500;\n    margin: 0;\n}\n\n.myfooter-newsletter-bar-form {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n}\n\n.myfooter-newsletter-bar-input {\n    background: transparent;\n    border: none;\n    border-bottom: 2px solid #333;\n    color: #fff;\n    padding: 10px 0;\n    width: 250px;\n    font-size: 14px;\n    transition: border-color 0.3s;\n    outline: none;\n\n    &:focus {\n        border-color: #00D8C0;\n    }\n}\n\n.myfooter-newsletter-bar-button {\n    background-color: #fff;\n    color: #000;\n    border: none;\n    padding: 12px 35px;\n    border-radius: 30px;\n    font-weight: 600;\n    font-size: 14px;\n    cursor: pointer;\n    transition: opacity 0.3s;\n\n    &:hover {\n        opacity: 0.9;\n    }\n}\n\n/* Divider Line */\n.myfooter-divider {\n    height: 1px;\n    background-color: #1a1a1a;\n    width: 100%;\n}\n\n/* Columns Section */\n.myfooter-content {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 60px 20px;\n}\n\n.myfooter-columns-container {\n    display: flex;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 40px;\n}\n\n.myfooter-column {\n    flex: 1;\n    min-width: 200px;\n}\n\n.myfooter-column-title {\n    font-size: 14px;\n    font-weight: 700;\n    margin-bottom: 30px;\n    color: #fff;\n    position: relative;\n    display: inline-block;\n    padding-bottom: 12px;\n    letter-spacing: 1px;\n\n    &::after {\n        content: '';\n        position: absolute;\n        bottom: 0;\n        left: 0;\n        width: 35px;\n        height: 2px;\n        background-color: #00D8C0;\n    }\n}\n\n/* Column 1: Contact */\n.myfooter-contact-list {\n    list-style: none;\n    padding: 0;\n    margin: 0 0 40px 0;\n\n    li {\n        display: flex;\n        align-items: flex-start;\n        gap: 15px;\n        margin-bottom: 25px;\n        color: #fff;\n        font-size: 18px; /* Increased from 14px */\n\n        i {\n            color: #fff;\n            font-size: 20px; /* Increased icon size */\n            margin-top: 3px;\n        }\n\n        a {\n            color: #fff;\n            text-decoration: none;\n            transition: color 0.3s;\n\n            &:hover {\n                color: #00D8C0;\n            }\n        }\n    }\n}\n\n.myfooter-address-item {\n    cursor: pointer;\n    transition: color 0.3s;\n\n    &:hover {\n        color: #ff0000 !important; /* Turns red on hover */\n        \n        .myfooter-address-text {\n            color: #ff0000 !important;\n        }\n        \n        i {\n            color: #ff0000 !important;\n        }\n    }\n}\n\n.myfooter-address-text {\n    line-height: 1.6;\n}\n\n.myfooter-logo {\n    margin-top: 20px;\n}\n\n.myfooter-logo-text {\n    font-size: 18px; /* Smaller as requested (from 24px) */\n    font-weight: 900;\n    letter-spacing: 8px;\n    color: #fff;\n}\n\n/* Links */\n.myfooter-column-links {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n\n    li {\n        margin-bottom: 20px;\n\n        a {\n            color: #fff;\n            text-decoration: none;\n            font-size: 14px;\n            transition: color 0.3s;\n\n            &:hover {\n                color: #00D8C0;\n            }\n        }\n    }\n}\n\n/* Social */\n.myfooter-social-icons {\n    display: flex;\n    gap: 15px;\n}\n\n.myfooter-social-icon-link {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    width: 35px;\n    height: 35px;\n    background-color: #1a1a1a;\n    border-radius: 50%;\n    color: #fff !important; /* Force white color for icon */\n    text-decoration: none;\n    transition: all 0.3s;\n\n    i {\n        font-family: 'FontAwesome', 'font-awesome', 'Font Awesome 5 Brands', 'Font Awesome 5 Free', 'Font Awesome 6 Brands', sans-serif !important;\n        font-style: normal !important;\n        font-variant: normal !important;\n        text-rendering: auto !important;\n        -webkit-font-smoothing: antialiased !important;\n        font-size: 18px !important;\n        line-height: 1 !important;\n        display: flex !important;\n        align-items: center !important;\n        justify-content: center !important;\n        color: #fff !important;\n        visibility: visible !important;\n        opacity: 1 !important;\n    }\n\n    &:hover {\n        background-color: #00D8C0;\n        color: #000 !important;\n        transform: translateY(-5px) rotate(360deg);\n        \n        i {\n            color: #000 !important;\n        }\n    }\n}\n\n/* Bottom Section */\n.myfooter-bottom {\n    border-top: 1px solid #1a1a1a;\n    padding: 40px 0;\n    text-align: right; /* Aligned to left as requested */\n}\n\n.myfooter-copyright {\n    font-size: 12px;\n    color: #666;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 20px;\n}\n\n/* Responsive */\n@media (max-width: 991px) {\n    .myfooter-newsletter-container {\n        flex-direction: column;\n        text-align: center;\n        gap: 20px;\n    }\n\n    .myfooter-columns-container {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n    }\n}\n\n@media (max-width: 767px) {\n    .myfooter-columns-container {\n        grid-template-columns: 1fr;\n    }\n\n    .myfooter-newsletter-bar-input {\n        width: 100%;\n    }\n}\n\n/* \n   CLEAN SLATE: Hiding original Horizon theme footer \n   This removes the \"Gap\" and the old copyright (© 2008-2018)\n*/\n.footer-content,\n.footer-content-nav,\n.footer-content-newsletter,\n.footer-content-bottom,\n.footer-social,\n#banner-footer {\n    display: none !important;\n    height: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n}\n\n.footer-wrapper {\n    background: transparent !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: none !important;\n}"}]}